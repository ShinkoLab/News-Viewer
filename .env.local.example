# Google Cloud project containing the Firestore database.
GOOGLE_CLOUD_PROJECT="your-google-cloud-project"
FIRESTORE_DATABASE="(default)"

# Local development with the Firestore emulator only:
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Default display order of categories, comma separated.
# The source of truth is News-Summarizer/categories.yaml — on Cloud Run this
# value is generated from that file by News-Summarizer/infra/main.tf, so never
# edit the order here alone. Unset simply degrades to name order.
CATEGORY_ORDER="AI・機械学習,テクノロジー,経済・ビジネス,政治・社会,事件・事故・災害,科学・環境,健康・ライフ,カルチャー"

# Semantic search. The Viewer embeds the search query and compares it against the
# vectors the summarizer stored in articleSummaries.embedding.
#
# These MUST match News-Summarizer's llm.embedding_base_url / llm.embedding_model
# exactly. A different model produces vectors that are not comparable to the stored
# ones, and the search silently returns unrelated articles — no error, no log.
# The source of truth is News-Summarizer/infra/variables.tf
# (var.embedding_base_url / var.embedding_model / var.embedding_dimension), which
# injects the same values into both the summarizer Job and the Viewer service.
#
# Leaving these unset simply degrades search to keyword matching; it never breaks
# the page.
# EMBEDDING_BASE_URL="https://openrouter.ai/api/v1"
# LLM_EMBEDDING_MODEL="openai/text-embedding-3-small"
# EMBEDDING_DIMENSION="1536"
# EMBEDDING_API_KEY="your-openrouter-api-key"
